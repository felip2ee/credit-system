# Banco e serviços locais (docker-compose.dev.yml)
DATABASE_URL=postgres://app_runtime:test@localhost:54329/credit_system
DATABASE_OWNER_URL=postgres://postgres:test@localhost:54329/credit_system
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
DOCUMENT_ROOT=/tmp/credit-system-documents

# Superadmin criado na primeira subida se ainda não existir (nunca sobrescreve)
SUPERADMIN_EMAIL=admin@example.test
SUPERADMIN_PASSWORD=troque-esta-senha-local

# Agente de IA (OpenAI)
OPENAI_API_KEY=
# ID do modelo OpenAI (ex.: gpt-4o, gpt-5, o3...). Default: gpt-4o
OPENAI_MODEL=gpt-4o

# Bureau deps.com.br (API Mix V3) — obrigatórias; sem as três o client lança erro
DEPS_API_BASE_URL=https://api-portal.deps.com.br
DEPS_API_EMAIL=
DEPS_API_PASSWORDL=
DEPS_API_CENTRO_CUSTOS=
# Opcional — nome exato do produto na conta deps (default: Smart PF 002 / Smart PJ 010).
# O identificador real (ex: 29375070) é obtido do retorno do login.
DEPS_PRODUTO_PF=Smart PF 002
DEPS_PRODUTO_PJ=Smart PJ 010

# SMTP — autogestão de SCR (envio do termo + código por e-mail). SECRETOS.
SMTP_HOST=                        # ex.: smtp.hostinger.com
SMTP_PORT=465                     # 465 = SSL implícito; 587 = STARTTLS
SMTP_SECURE=true                  # true p/ 465, false p/ 587
SMTP_USER=                        # caixa de envio
SMTP_PASS=                        # SECRETO — senha da caixa
SMTP_FROM=                        # opcional — ex.: Rainha Cred <contato@dominio.com>

# O link do e-mail de autorização SCR usa BETTER_AUTH_URL (ver .env.example).

# Pagamentos (dev): chave PII pública (nunca em produção) e taxas do Asaas repassadas ao pagador.
PII_ENCRYPTION_KEY=dev:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
CARD_FEE_TABLE=1:2.99:49,6:2.99:49,12:2.99:49
CARD_MIN_INSTALLMENT_CENTS=500
PIX_FEE_CENTS=199
