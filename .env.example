# ============================================================================
#  .env.example  —  full deployment reference
# ============================================================================
#  Three groups:
#    1. LOCAL DEV  — copy to `.env.local`, `npm run dev` reads these.
#    2. STACK DEPLOY ENV — exported in the shell that runs `docker stack deploy`
#       (docker-stack.yml interpolates ${VAR}). NOT secrets.
#    3. DOCKER SECRETS — created once with `docker secret create`, never in a
#       file or in env. The stack mounts them at /run/secrets/<name>.
# ============================================================================


# --- 1. LOCAL DEV -----------------------------------------------------------
DATABASE_URL=postgres://app_runtime:test@localhost:54329/credit_system
# Role app_webhook: the Asaas webhook route only (EXECUTE on apply_asaas_payment, no table access).
DATABASE_WEBHOOK_URL=postgres://app_webhook:test@localhost:54329/credit_system
# Role app_dispatch: the notifications dispatch route only (EXECUTE on claim_notifications, complete_notification).
DISPATCH_DATABASE_URL=postgres://app_dispatch:test@127.0.0.1:54329/credit_system
BETTER_AUTH_SECRET=0123456789abcdef0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000
DOCUMENT_ROOT=/tmp/credit-system-documents
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
SMTP_HOST=smtp.example.test
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=credit-system
SMTP_PASS=test-password
SMTP_FROM=Rainha do Crédito <credit-system>
TRAEFIK_PROXY_CIDR=10.0.0.0/8
# Owner/superuser DSN — only used by the migration runner (scripts/db/migrate.mjs)
# and the app entrypoint. Locally this is fine; in prod it is a Docker secret.
DATABASE_OWNER_URL=postgres://postgres:test@localhost:54329/credit_system
DEPS_API_BASE_URL=https://api-portal.deps.com.br
DEPS_API_EMAIL=deps-user
DEPS_API_PASSWORDL=deps-password
OPENAI_API_KEY=sk-local-placeholder
# Asaas (recarga PIX). ASAAS_DRIVER=fake only outside production; "asaas" needs the next three.
ASAAS_DRIVER=fake
ASAAS_WEBHOOK_TOKEN=local-webhook-token-0123456789abcdef
ASAAS_API_KEY=
ASAAS_API_BASE_URL=https://api-sandbox.asaas.com
ASAAS_CUSTOMER_ID=
# NFS-e (docs/operations/nfse.md). All empty = NFS-e off (nothing is scheduled). Fill ONLY after the accountant validates it.
# Set NFSE_MUNICIPAL_SERVICE_ID or NFSE_MUNICIPAL_SERVICE_CODE; then the other three are required.
NFSE_MUNICIPAL_SERVICE_ID=
NFSE_MUNICIPAL_SERVICE_CODE=
NFSE_MUNICIPAL_SERVICE_NAME=
NFSE_SERVICE_DESCRIPTION=
# ISS rate in percent, 0 to 5 (2.5 = 2,5%).
NFSE_ISS_RATE=
NFSE_RETAIN_ISS=false
# Notificações (docs/operations/notifications.md). WHATSAPP_DRIVER=fake only outside production.
# With the fake driver, PHONE_NUMBER_ID (digits) and APP_SECRET/VERIFY_TOKEN (32+ chars) are required. Empty WHATSAPP_DRIVER = WhatsApp off.
WHATSAPP_DRIVER=fake
WHATSAPP_PHONE_NUMBER_ID=100000000000001
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=local-app-secret-0123456789abcdef0123
WHATSAPP_VERIFY_TOKEN=local-verify-token-0123456789abcdef
NOTIFICATIONS_DISPATCH_SECRET=local-dispatch-secret-0123456789abcdef
NOTIFICATIONS_DISPATCH_URL=http://localhost:3000/api/internal/notifications/dispatch
ORDERS_TICK_URL=http://localhost:3000/api/internal/orders/tick


# --- 2. STACK DEPLOY ENV --------------------------------------------------
#  export these before `docker stack deploy -c docker-stack.yml reino`
#
#  REINO_IMAGE_OWNER=felip2ee
#  REINO_IMAGE_DIGEST=<64-hex sha256 of ghcr.io/<owner>/reino-credito>   # from the GHCR workflow summary
#  REINO_BACKUP_DIGEST=<64-hex sha256 of ghcr.io/<owner>/reino-backup>   # idem
#  APP_DOMAIN=app.seudominio.com.br
#  TRAEFIK_PROXY_CIDR=10.0.0.0/8            # docker overlay range; keeps forwarded-IP trust tight
#  SMTP_HOST=smtp.seuprovedor.com
#  SMTP_PORT=465
#  SMTP_SECURE=true
#  SMTP_USER=no-reply@seudominio.com.br
#  SMTP_FROM=Rainha do Crédito <no-reply@seudominio.com.br>
#  DEPS_API_EMAIL=<usuario-deps>
#  DEPS_API_CENTRO_CUSTOS=                  # optional
#  BACKUP_ALERT_TO=ops@seudominio.com.br
#  OPS_ALERT_TO=ops@seudominio.com.br
#  RESTIC_S3_ENDPOINT=s3.us-west-004.backblazeb2.com
#  RESTIC_S3_BUCKET=<bucket>
#  # S3 keys are Docker secrets (restic_s3_access_key, restic_s3_secret_key), never env
#  OPENAI_MODEL=gpt-4o                      # optional, default gpt-4o
#  WHATSAPP_DRIVER=meta                     # empty (default) = WhatsApp off
#  WHATSAPP_PHONE_NUMBER_ID=<id do número na Meta>
#  WHATSAPP_GRAPH_VERSION=v21.0
#  SUPERADMIN_EMAIL=voce@seudominio.com.br  # optional; empty = no superadmin bootstrap


# --- 3. DOCKER SECRETS (22) ---------------------------------------------------
#  Generate strong values, store them in a password manager, then:
#
#  PG_SUPER_PW=$(openssl rand -hex 24)
#  APP_RUNTIME_PW=$(openssl rand -hex 24)
#  SCHEMA_OWNER_PW=$(openssl rand -hex 24)
#  BACKUP_READER_PW=$(openssl rand -hex 24)
#  APP_WEBHOOK_PW=$(openssl rand -hex 24)
#  APP_DISPATCH_PW=$(openssl rand -hex 24)
#
#  # role passwords (also embedded in the DSN secrets below)
#  printf %s "$PG_SUPER_PW"      | docker secret create postgres_password -
#  printf %s "$SCHEMA_OWNER_PW"  | docker secret create schema_owner_password -
#  printf %s "$APP_RUNTIME_PW"   | docker secret create app_runtime_password -
#  printf %s "$BACKUP_READER_PW" | docker secret create backup_reader_password -
#  printf %s "$APP_WEBHOOK_PW"   | docker secret create app_webhook_password -
#  printf %s "$APP_DISPATCH_PW"  | docker secret create app_dispatch_password -
#
#  # DSNs — host is the compose service name `postgres` on the internal overlay
#  printf %s "postgresql://app_webhook:${APP_WEBHOOK_PW}@postgres:5432/credit_system" \
#    | docker secret create database_webhook_url -
#  printf %s "postgresql://app_dispatch:${APP_DISPATCH_PW}@postgres:5432/credit_system" \
#    | docker secret create dispatch_database_url -
#  printf %s "postgresql://app_runtime:${APP_RUNTIME_PW}@postgres:5432/credit_system" \
#    | docker secret create database_url -
#  printf %s "postgresql://postgres:${PG_SUPER_PW}@postgres:5432/credit_system" \
#    | docker secret create database_owner_url -     # superuser: runs CREATE/ALTER ROLE + bypasses FORCE RLS
#
#  # app
#  printf %s "$(openssl rand -hex 32)" | docker secret create better_auth_secret -   # >= 32 chars
#  printf %s "<smtp-password>"         | docker secret create smtp_pass -
#  printf %s "<deps-api-password>"     | docker secret create deps_api_password -
#  printf %s "<openai-api-key>"        | docker secret create openai_api_key -
#  # Asaas (when ASAAS_DRIVER=asaas): ASAAS_API_KEY and ASAAS_WEBHOOK_TOKEN also accept *_FILE (Docker secrets);
#  # the stack file does not mount them yet.
#  printf %s "<senha-do-superadmin>"   | docker secret create superadmin_password -  # 12-128 chars
#  # notifications — WhatsApp off: use any placeholder for the two Meta secrets (Swarm rejects empty secrets)
#  printf %s "<token-de-sistema-meta>" | docker secret create whatsapp_access_token -
#  printf %s "<app-secret-meta>"       | docker secret create whatsapp_app_secret -
#  printf %s "$(openssl rand -hex 32)" | docker secret create whatsapp_verify_token -
#  printf %s "$(openssl rand -hex 32)" | docker secret create notifications_dispatch_secret -
#
#  # backup — encrypted Restic repo in an S3 bucket
#  printf %s "$(openssl rand -hex 32)" | docker secret create restic_password -      # KEEP THIS — no key, no restore
#  printf %s "<s3-access-key>"        | docker secret create restic_s3_access_key -
#  printf %s "<s3-secret-key>"        | docker secret create restic_s3_secret_key -
#
#  docker secret ls    # expect 22
#
#  Restic repo location: S3 bucket RESTIC_S3_BUCKET at RESTIC_S3_ENDPOINT (versioning on, public access denied).
