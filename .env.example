# ============================================================================
#  .env.example  —  full deployment reference
# ============================================================================
#  Three groups:
#    1. LOCAL DEV  — copy to `.env.local`, `npm run dev` reads these.
#    2. STACK DEPLOY ENV — exported in the shell that runs `docker stack deploy`
#       (docker-stack.yml interpolates ${VAR}). NOT secrets.
#    3. DOCKER SECRETS — created once with `docker secret create`, never in a
#       file or in env. The stack mounts them at /run/secrets/<name>.
# ============================================================================


# --- 1. LOCAL DEV -----------------------------------------------------------
DATABASE_URL=postgres://app_runtime:test@localhost:54329/credit_system
BETTER_AUTH_SECRET=0123456789abcdef0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000
DOCUMENT_ROOT=/var/lib/reino/documents
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
SMTP_HOST=smtp.example.test
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=credit-system
SMTP_PASS=test-password
SMTP_FROM=Rainha do Crédito <credit-system>
TRAEFIK_PROXY_CIDR=10.0.0.0/8
# Owner/superuser DSN — only used by the migration runner (scripts/db/migrate.mjs)
# and the app entrypoint. Locally this is fine; in prod it is a Docker secret.
DATABASE_OWNER_URL=postgres://postgres:test@localhost:54329/credit_system
DEPS_API_BASE_URL=https://api-portal.deps.com.br
DEPS_API_EMAIL=deps-user
DEPS_API_PASSWORDL=deps-password
OPENAI_API_KEY=sk-local-placeholder


# --- 2. STACK DEPLOY ENV --------------------------------------------------
#  export these before `docker stack deploy -c docker-stack.yml reino`
#
#  REINO_IMAGE_OWNER=felip2ee
#  REINO_IMAGE_DIGEST=<64-hex sha256 of ghcr.io/<owner>/reino-credito>   # from the GHCR workflow summary
#  REINO_BACKUP_DIGEST=<64-hex sha256 of ghcr.io/<owner>/reino-backup>   # idem
#  APP_DOMAIN=app.seudominio.com.br
#  TRAEFIK_PROXY_CIDR=10.0.0.0/8            # docker overlay range; keeps forwarded-IP trust tight
#  SMTP_HOST=smtp.seuprovedor.com
#  SMTP_PORT=465
#  SMTP_SECURE=true
#  SMTP_USER=no-reply@seudominio.com.br
#  SMTP_FROM=Rainha do Crédito <no-reply@seudominio.com.br>
#  DEPS_API_EMAIL=<usuario-deps>
#  DEPS_API_CENTRO_CUSTOS=                  # optional
#  BACKUP_ALERT_TO=ops@seudominio.com.br
#  OPENAI_MODEL=gpt-4o                      # optional, default gpt-4o


# --- 3. DOCKER SECRETS (11) ---------------------------------------------------
#  Generate strong values, store them in a password manager, then:
#
#  PG_SUPER_PW=$(openssl rand -hex 24)
#  APP_RUNTIME_PW=$(openssl rand -hex 24)
#  SCHEMA_OWNER_PW=$(openssl rand -hex 24)
#  BACKUP_READER_PW=$(openssl rand -hex 24)
#
#  # role passwords (also embedded in the DSN secrets below)
#  printf %s "$PG_SUPER_PW"      | docker secret create postgres_password -
#  printf %s "$SCHEMA_OWNER_PW"  | docker secret create schema_owner_password -
#  printf %s "$APP_RUNTIME_PW"   | docker secret create app_runtime_password -
#  printf %s "$BACKUP_READER_PW" | docker secret create backup_reader_password -
#
#  # DSNs — host is the compose service name `postgres` on the internal overlay
#  printf %s "postgresql://app_runtime:${APP_RUNTIME_PW}@postgres:5432/credit_system" \
#    | docker secret create database_url -
#  printf %s "postgresql://postgres:${PG_SUPER_PW}@postgres:5432/credit_system" \
#    | docker secret create database_owner_url -     # superuser: runs CREATE/ALTER ROLE + bypasses FORCE RLS
#
#  # app
#  printf %s "$(openssl rand -hex 32)" | docker secret create better_auth_secret -   # >= 32 chars
#  printf %s "<smtp-password>"         | docker secret create smtp_pass -
#  printf %s "<deps-api-password>"     | docker secret create deps_api_password -
#  printf %s "<openai-api-key>"        | docker secret create openai_api_key -
#
#  # backup — local encrypted Restic repo, no S3
#  printf %s "$(openssl rand -hex 32)" | docker secret create restic_password -      # KEEP THIS — no key, no restore
#
#  docker secret ls    # expect 11
#
#  Restic repo location: the `restic_repo` volume in docker-stack.yml. For real
#  disaster tolerance bind it to a SEPARATE disk before deploy:
#    docker volume create --driver local --opt type=none --opt o=bind \
#      --opt device=/srv/reino-restic reino_restic_repo
